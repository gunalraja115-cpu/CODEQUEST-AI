# =========================================================
# CodeRoyale — Environment Variables
# COPY this file to `.env` and fill in real values.
# NEVER commit your real .env to source control.
# =========================================================

# --- Database ---
DB_ROOT_PASSWORD=rootpassword
DB_USER=coderoyale
DB_PASSWORD=coderoyale

# --- JWT ---
# REQUIRED: Replace with a 64+ character random secret in production!
JWT_SECRET=CodeRoyaleUltraSecureQuantumSecretKeyForJwt2026EsportsBattleArena
JWT_EXPIRATION_MS=86400000

# --- Code Execution (Judge0) ---
# Sign up at https://rapidapi.com/judge0-official/api/judge0-ce
# Leave blank to use built-in deterministic simulation (dev mode)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=

# --- AI Coach (CYBER-SAGE LLM Proxy) ---
# OpenAI-compatible endpoint. Leave blank to use intelligent fallback responses (dev mode)
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4o-mini
